# ============================================================================
# FinanceiroApp — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA envie o .env real para o GitHub.
# ============================================================================

# Banco de dados PostgreSQL (Neon).
# No Neon, use a connection string "Pooled connection" para a aplicação.
# Para rodar migrations, se necessário, use a "Direct connection".
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/financeiro?sslmode=require"

# Segredo do Better Auth. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação.
# Local: http://localhost:3000
# Produção: https://seu-projeto.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
