# ============================================================================
# FinanceiroApp — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA envie o .env real para o GitHub.
# ============================================================================

# Banco de dados PostgreSQL (Neon).
# A aplicação usa a connection string pooled.
# Migrações e inspeção usam a conexão direta.
# Prefira sslmode=verify-full para validar o certificado do servidor.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/financeiro?sslmode=verify-full"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/financeiro?sslmode=verify-full"
# Compatibilidade: DATABASE_URL_UNPOOLED também é aceita como conexão direta.
# DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/financeiro?sslmode=verify-full"

# Segredo do Better Auth. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação.
# Local: http://localhost:3000
# Produção: https://seu-projeto.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Lembretes por e-mail (opcional).
# Sem EMAIL_SMTP_HOST e EMAIL_FROM o envio é ignorado e o cron apenas registra
# que não há SMTP configurado.
EMAIL_FROM="FinanceiroApp <nao-responda@seudominio.com>"
EMAIL_SMTP_HOST="smtp.seudominio.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="usuario-smtp"
EMAIL_SMTP_PASS="senha-ou-app-key"

# Protege /api/cron/reminders, chamado pelo Vercel Cron.
# Gere com o mesmo comando do BETTER_AUTH_SECRET.
CRON_SECRET="troque-por-um-segredo-aleatorio"
